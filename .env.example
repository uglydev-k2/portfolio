# Public site URL used for the sitemap, robots.txt, and Open Graph tags.
# On Vercel, set this to your production URL, for example https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formspree form id. Overrides formspreeId in data/profile.ts.
# If your endpoint is https://formspree.io/f/abcdwxyz the id is abcdwxyz.
NEXT_PUBLIC_FORMSPREE_ID=
